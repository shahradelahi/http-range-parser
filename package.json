{
  "name": "@se-oss/range-parser",
  "version": "2.0.0",
  "description": "Lightweight HTTP Range header parser.",
  "keywords": [
    "http",
    "range",
    "parser",
    "header"
  ],
  "homepage": "https://github.com/shahradelahi/http-range-parser#readme",
  "repository": "github:shahradelahi/http-range-parser",
  "license": "MIT",
  "author": "Shahrad Elahi <shahrad@litehex.com> (https://github.com/shahradelahi)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "bench": "vitest bench --run",
    "build": "tsup",
    "ci:publish": "changeset publish",
    "clean": "git clean -dfx node_modules dist .tsbuildinfo",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm typecheck && eslint .",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "pnpm build && pnpm lint && pnpm format:check && pnpm test",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@shahrad/prettier-config",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@shahrad/eslint-config": "^1.1.0",
    "@shahrad/prettier-config": "^2.0.1",
    "@shahrad/tsconfig": "^1.3.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
